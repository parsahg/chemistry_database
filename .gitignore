cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Python packaging
*.egg-info/
dist/
build/

# Environment / secrets
.env
.env.*

# Logs
*.log

# Caches
.cache/
.pytest_cache/

# Project-generated/cache data
chemistry_pipeline/data/cache/
chemistry_pipeline/data/processed/
chemistry_pipeline/data/simulated/
chemistry_pipeline/data/raw/
# PubChem/API cache
chemistry_pipeline/data/reference/pubchem_cache.json

EOF